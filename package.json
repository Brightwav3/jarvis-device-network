{
  "name": "device-network",
  "version": "0.1.0",
  "private": true,
  "description": "Headless, agent-oriented device communication infrastructure.",
  "type": "module",
  "bin": {
    "device-network-simulator": "./dist/simulator/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "pino": "^9.14.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  }
}
